APP_NAME="Africand Intelligence"
ENVIRONMENT=development

# PostgreSQL recommande en production (ex: Supabase) ; SQLite par defaut pour le MVP local
DATABASE_URL=sqlite:///./africand_intelligence.db
# DATABASE_URL=postgresql://user:password@localhost:5432/africand_intelligence

# Fournisseur IA : mock (par defaut, sans cle), openai ou anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@africand.com
ADMIN_PASSWORD=change-me-in-production

CORS_ORIGINS=["http://localhost:3000"]
